	chunk ::= {stat [`;´]}

	block ::= chunk

	stat ::=  var `=´ exp
	        | functioncall
	        | `do´ block `end´
	        | `while´ exp `do´ block `end´
	        | `repeat´ block `until´ exp
	        | `if´ exp `then´ block {`elseif´ exp `then´ block} [`else´ block] `end´
	        | `for´ Name `=´ exp `,´ exp [`,´ exp] `do´ block `end´
	        | `function´ Name `(` [namelist] `)` block `end´
	        | `local´ Name [`=´ exp]
	        | `return´ [exp]
	        | `break´

	var ::= Name

	namelist ::= Name {`,´ Name}

	exp ::= nil | false | true | Number | String | var
	      | `(` exp `)`
	      | exp binop exp
	      | unop exp
	      | prefixexp `(` [explist] `)`

	explist ::= {exp `,´} exp

	binop ::= `+´ | `-´ | `*´ | `/´ | `==´ | `~=´
	        | `<´ | `<=´ | `>´ | `>=´ | and | or

	unop ::= `-´ | not | `#´

	comment ::= `--´ {any char} [newline]
